# Copy this file to `.env.local` for local development.
# Do NOT commit `.env.local`.

# -----------------------------
# Server-only environment vars
# -----------------------------

# Gemini API key (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Optional allowlist for CORS (comma-separated origins)
# Example: "http://localhost:5173,http://localhost:3000,https://your-app.vercel.app"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# -----------------------------
# Client (Vite) environment vars
# Exposed to the browser; do NOT put secrets here.
# -----------------------------

VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"

# If you use a non-default Firestore database, set it here. Otherwise leave empty.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
